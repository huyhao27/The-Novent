{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./Library/Artifacts/**)",
      "Read(./Library/Bee/**)",
      "Read(./Library/ShaderCache/**)",
      "Read(./Library/ScriptAssemblies/**)",
      "Read(./Library/StateCache/**)",
      "Read(./Library/PlayerDataCache/**)",
      "Read(./Temp/**)",
      "Read(./Logs/**)",
      "Read(./obj/**)",
      "Read(./UserSettings/**)",
      "Read(./Build/**)",
      "Read(./Builds/**)",
      "Read(./*.csproj)",
      "Read(./*.slnx)",
      "Read(./*.sln)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\" 2>/dev/null || python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\" 2>/dev/null || py -3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill_router.py\" 2>/dev/null || python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill_router.py\" 2>/dev/null || py -3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill_router.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" 2>/dev/null || python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" 2>/dev/null || py -3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
